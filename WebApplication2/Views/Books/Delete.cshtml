@model BookCatalog.Models.Book
@{
    ViewData["Title"] = "Удаление книги";
}

< h2 > Удаление книги </ h2 >
< div class= "alert alert-danger" >
    < h4 > Вы уверены, что хотите удалить книгу?</h4>
        <hr />
        <dl class="row">
            < dt class= "col-sm-3" > Название </ dt >
            < dd class= "col-sm-9" > @Model.Title </ dd >
            < dt class= "col-sm-3" > Автор </ dt >
            < dd class= "col-sm-9" > @Model.Author?.FullName </ dd >
            < dt class= "col-sm-3" > Жанр </ dt >
            < dd class= "col-sm-9" > @Model.Genre?.Name </ dd >
            < dt class= "col-sm-3" > Год </ dt >
            < dd class= "col-sm-9" > @Model.Year </ dd >
        </ dl >

        < form asp - action = "Delete" >
            < input type = "hidden" asp -for= "Id" />
            < input type = "submit" value = "Удалить" class= "btn btn-danger" />
            < a asp - action = "Index" class= "btn btn-secondary" > Отмена </ a >
        </ form >
    </ div >