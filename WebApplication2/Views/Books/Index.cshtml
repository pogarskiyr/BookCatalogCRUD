@model IEnumerable<BookCatalog.Models.Book>
@{
    ViewData["Title"] = "Каталог книг";
    var authors = ViewBag.Authors as List<BookCatalog.Models.Author>;
}

<h1>Каталог книг</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить новую книгу</a>
</p>

<!-- Поиск и фильтр -->
<form method="get" class="row g-3 mb-3">
    <div class="col-md-5">
        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Поиск по названию" />
    </div>
    <div class="col-md-4">
        <select name="authorId" class="form-select">
            <option value="">Все авторы</option>
            @foreach (var author in authors)
            {
                <option value="@author.Id" selected="@(ViewBag.CurrentAuthorId == author.Id ? "selected" : null)">
                    @author.FullName
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-secondary">Применить</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Год</th>
            <th>Цена</th>
            <th>Автор</th>
            <th>Жанр</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Year</td>
                <td>@(item.Price?.ToString("C") ?? "-")</td>
                <td>@item.Author?.FullName</td>
                <td>@item.Genre?.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>