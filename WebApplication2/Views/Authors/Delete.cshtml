@model BookCatalog.Models.Author
@{
    ViewData["Title"] = "Удаление автора";
}

<h2>Удаление автора</h2>

<div class="alert alert-danger">
    <h4>Вы уверены, что хотите удалить этого автора?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Полное имя</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Год рождения</dt>
        <dd class="col-sm-9">@(Model.BirthYear?.ToString() ?? "—")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>