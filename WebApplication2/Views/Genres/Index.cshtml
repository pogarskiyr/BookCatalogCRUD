@model IEnumerable<BookCatalog.Models.Genre>
@{
    ViewData["Title"] = "Жанры";
    var bookCounts = ViewBag.BookCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h1>Жанры</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить новый жанр</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название жанра</th>
            <th>Количество книг</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(bookCounts.ContainsKey(item.Id) ? bookCounts[item.Id] : 0)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>